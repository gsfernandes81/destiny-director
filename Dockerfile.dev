# syntax=docker/dockerfile:1

# dd-dev — a THIN CHILD of gsrpi-dev-base since 2026-08-24. Everything this container
# shares with its siblings (infra-dev, or3-dev, ds-dev) lives in infra's
# `dev/Dockerfile.base` and is pulled, not rebuilt: Debian slim, Node + Claude Code, `gh`,
# zmx, screen, fish, the ssh client and server, the `dev` user, every dotfile, and the
# entrypoint that starts the lot. What is left here is only what makes this image not one
# of the others — the database clients, the Railway CLI, and this project's venv.
#
# WHO BUILDS IT, since 2026-10-27: infra. dd-dev is a service in infra's dev/compose.yaml,
# which builds this file straight from this repo's `main` on GitHub (no host clone) and
# passes BASE_TAG from its own `x-base-tag` line — so the default below is only a
# fallback for a build by hand, kept at the tag infra passes. Its name, volumes, memory
# cap, secrets directory and environment are all in that service definition; lifecycle is
# `make up S=dd-dev` / `restart` / `stop` / `shell` / `login` with C=dd-dev, in
# ~/infra/dev on zero (infra's dev/README.md).
#
# PINNED TAG, never `latest`: a base rebuild must not change this container until the tag
# moves. The base is PUBLIC on ghcr, so the FROM pulls and there is no cross-repo build
# order; infra's `make base` builds it locally under the same name when a pull is not an
# option, and docker prefers a local image over a pull.
ARG BASE_TAG=2026.10.26
FROM ghcr.io/gsfernandes81/gsrpi-dev-base:${BASE_TAG}

# Re-declared, because an ARG stated before FROM is out of scope after it. Recorded as a
# label so WHICH BASE THIS CONTAINER IS ON is answerable from a running container —
# `docker inspect dd-dev --format '{{index .Config.Labels "uk.gsrpi.base-tag"}}'` — rather
# than inferred from behaviour, which is the kind of check that passes for a wrong reason.
ARG BASE_TAG
LABEL uk.gsrpi.base-tag="${BASE_TAG}"

# The base ends as the dev user; everything below writes system paths until USER dev.
USER root

# What the base does not carry, and why each is here rather than there:
#   build-essential   wheels this project builds from source on arm64.
#   libjemalloc2      docker-run-devbot.sh LD_PRELOADs it so a locally-run dev bot
#                     mirrors the deployed image's allocator (the repo-root Dockerfile's
#                     LD_PRELOAD/MALLOC_CONF) for RAM work.
#   postgresql-client psql against the `postgres` sibling service, and pg_dump for
#                     `make dump-db`. Pulls in libpq5, which psycopg's pure-Python
#                     distribution also dlopens at import.
#   mariadb-client    `mysqldump` alone: `make dump-mysql` / `cutover-backup` take the
#                     pre-cutover backup of the old MySQL, the one artefact of that
#                     cutover which cannot be reconstructed afterwards. Debian ships
#                     MariaDB's client rather than Oracle's, which is fine for a logical
#                     dump and accepts the flags the Makefile passes.
# git, make, screen, fish, the ssh client and server, curl, gnupg, ca-certificates and
# tzdata all come from the base, as does zmx, which holds every session the hub's menu
# opens across a dropped link.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libjemalloc2 postgresql-client mariadb-client \
    && rm -rf /var/lib/apt/lists/*

# Railway CLI: install the release tarball directly. The @railway/cli npm package's
# postinstall requests an aarch64-*-linux-gnu asset that Railway does NOT publish
# (arm64 ships only -musl), so it 404s on the Pi. The musl build is statically
# linked and runs fine on Debian/glibc. Bump RAILWAY_VERSION to upgrade.
ARG RAILWAY_VERSION=v5.23.3
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      arm64) target="aarch64-unknown-linux-musl" ;; \
      amd64) target="x86_64-unknown-linux-gnu" ;; \
      *) echo "unsupported arch: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/railwayapp/cli/releases/download/${RAILWAY_VERSION}/railway-${RAILWAY_VERSION}-${target}.tar.gz" \
      | tar -xz -C /usr/local/bin railway; \
    railway --version

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# The dev account's login shell goes back to bash, which the base sets to fish. Not a
# preference — it is the shell sshd takes from /etc/passwd, and the base's dev-door runs
# every forwarded command under it (`$SHELL -c '…'`): the hub's own calls into this
# container, and every `ssh dev ssh dd-dev '<cmd>'`. This repo's tooling has always
# assumed a POSIX shell there: `VAR=x cmd` prefixes, `$(...)`, and `export` are all fish
# syntax errors. The pre-base Dockerfile said the same thing in its useradd, and the
# conversion should not quietly reverse a choice this repo had made. fish is still
# installed for anyone who wants it interactively.
RUN usermod --shell /bin/bash dev

# TZ, CLAUDE_CONFIG_DIR, GH_CONFIG_DIR, HISTFILE and SCREENDIR are all set in
# the base and are deliberately not repeated here — a value stated twice is a value that
# drifts. What is left is this project's own.
#
# VIRTUAL_ENV mirrors UV_PROJECT_ENVIRONMENT so ty/ruff toolchain detection find the venv
# in an ssh session (they key off VIRTUAL_ENV, and this repo has no project-local .venv).
# Zed's would too, but Zed has no route to a container behind the hub at present.
# RAILWAY_NO_AUTO_UPDATE is Railway's own documented switch, and it belongs here because
# RAILWAY_VERSION above PINS the CLI: a binary that updates itself would drift off the pin
# on somebody's first command.
#
# PATH IS NEW, and it replaces a line in the old entrypoint. That entrypoint published
# `PATH=/home/dev/venv/bin:$PATH` into ~/.ssh/environment, so an ssh session had the venv
# and a `docker exec` did not — the same container answering `python` two different ways
# depending on how you arrived. Setting it in the image makes both agree, and the base
# publishes whatever PATH it inherits, so ssh sessions keep it.
ENV RAILWAY_NO_AUTO_UPDATE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/home/dev/venv \
    VIRTUAL_ENV=/home/dev/venv \
    PATH=/home/dev/venv/bin:$PATH

# Pre-build the full dependency set (dev + speedups) into /home/dev/venv. The editable
# project is added at container start by child-init.sh, once /workspace — a volume, cloned
# at first start — holds the checkout. These two COPYs are also what seeds a new workspace
# volume; the base's clone adopts them.
#
# RUN AS ROOT AND CHOWNED, which is a change from the pre-base version of this file and
# is caused by the base rather than chosen. A BuildKit cache mount is created root-owned
# and takes a NUMERIC uid to be anything else — the old file passed ${USER_UID}, the build
# arg that no longer exists here because the base owns the account. Rather than guess that
# number (the CI base bakes 1001, a `make base` bakes the clone owner's), the sync runs as
# root against a root-owned cache and the venv is handed to dev in the same layer. The
# alternative — dropping the cache mount — costs a full re-download of every wheel on
# every rebuild, which on a Pi is the difference between a minute and several.
COPY --chown=dev:dev pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv uv sync --frozen --no-install-project \
    && chown -R dev:dev /home/dev/venv

USER dev

# The volume mountpoints the base does not already create. It pre-creates .claude,
# .config/gh, .ssh-host and .local/share as the dev user; these three are this repo's.
# A volume that is empty on first use inherits the ownership of the directory it covers,
# so a mountpoint created by root is one uv, railway and Zed cannot write to.
RUN mkdir -p /home/dev/.cache/uv /home/dev/.railway /home/dev/.zed_server

# ── the seams, which is all a child is meant to need ────────────────────────
#
# ~/.ssh/config's baked half. The base prepends $DEV_SECRETS_DIR/ssh_config.fleet — on
# zero, ~/.dd-dev-secrets, mounted read-only; this repo's ssh identities, if any — to it at
# every start, so what this file carries is only the defaults. See ssh_config.dev, which
# explains why it names no key and why origin needs none.
COPY --chown=dev:dev ssh_config.dev /home/dev/ssh_config

# NO sshd DROP-INS. Since base 2026-10-27 sshd reads only the base's own sshd_config, and a
# drop-in a child COPYs into ~/sshd_config.d is ignored; the two this repo had (the host
# account's authorized_keys, and TCP forwarding) went with the host .ssh mount and the
# published port they served. The way in is the hub — `ssh dev`, then dd-dev in the menu.

# The login walkthrough, this repo's own: its steps are THIS repo's preconditions — the
# hub's GitHub token, the workspace and .env, ssh identities, Railway, Claude. It lives in
# the image because every step needs a tty and every credential store it fills is in here;
# `make login C=dd-dev` in infra's dev/ runs it.
COPY --chown=dev:dev docker-login.dev.sh /home/dev/login.sh

# What this image does at start that the base cannot know about.
COPY --chown=dev:dev docker-child-init.dev.sh /home/dev/child-init.sh

# WORKDIR, EXPOSE and CMD are inherited. Everything else this container is — its name,
# its volumes, its memory cap, its secrets directory, its environment — is the dd-dev
# service in infra's dev/compose.yaml, which is where the values that genuinely differ
# belong.
