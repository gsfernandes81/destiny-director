# NOTE: the settings that used to live here — every followable's post channel
# (FOLLOWABLES), the log/alerts channels, the embed colours, ALERT_MIN_LEVEL,
# DEFAULT_URL, DISABLE_BAD_CHANNELS and the Lost Sector / Xur image URLs — are now DB
# rows edited on anchor's Autopost Settings web page, and are NOT read from the
# environment at all. Setting them here does nothing. A fresh install starts with every
# feed dormant (beacon logs a CRITICAL naming each unconfigured feed at boot) until the
# channels are set on that page; there is deliberately no seeding path, so that the
# page's validation — right server, announcement channel, bot can actually post there —
# is the only way a value gets in.

# Discord control server config
CONTROL_DISCORD_SERVER_ID=1000000000000000000
KYBER_DISCORD_SERVER_ID=1000000000000000000

# Discord environment config
DISCORD_TOKEN_ANCHOR=fv4vwjn34jgvjsglmlers
DISCORD_TOKEN_BEACON=fv4vwjn34jgvjsglmlers
TEST_ENV=1000000000000000000,1000000000000000001

# Database. DATABASE_PRIVATE_URL is preferred over DATABASE_URL when both are set
# (Railway injects both; the private one stays on the internal network). Postgres
# (postgresql://) and SQLite (sqlite:///path/to.db) URLs are accepted.
DATABASE_PRIVATE_URL=postgresql://username:password@hostname/dbname
DATABASE_URL=postgresql://username:password@hostname/dbname
# Postgres TLS. Defaults to true, which appends sslmode=require to the URL above.
# In case you are using a Postgres instance without ssl set the below
# DATABASE_SSL=false

# Each bot runs `alembic upgrade head` itself on startup (before it touches a table),
# so the migration is ordered by straight-line Python rather than by a shell entrypoint
# — supervisord, PID 1 in the container, has no dependency/ordering mechanism to
# sequence a migration step ahead of the bot. Both bots doing it is fine: env.py takes
# an advisory lock, so the loser waits and then finds nothing to do. Defaults to true.
# Set false to run against a database somebody else migrates.
# RUN_MIGRATIONS_ON_STARTUP=false

# OOM-kill preference the bot process raises ITSELF to at startup (-1000..1000; unset
# leaves it at the container default). The direction matters: Linux always lets a
# process RAISE its own /proc/self/oom_score_adj, but LOWERING it below the current
# value needs CAP_SYS_RESOURCE, which rootless podman cannot grant. So the container
# baseline stays at the default 0 — protecting supervisord and sshd, which cannot be
# protected after the fact — and the bot pushes itself up, making the kernel reap the
# bot first when the cgroup runs out of memory. Distinct from DEVBOT_OOM_SCORE_ADJ
# below, which the dev runner applies externally via choom.
# OOM_SCORE_ADJ=800

# --- Deployed container (supervisord PID 1; see supervisord.conf + Dockerfile) ------
# These are read by the IMAGE, not by dd.common.cfg, so they only matter for a container
# deploy — a local `make run-beacon-local` ignores all three.
#
# Which bot the container runs: supervisord's only program is
# `python -OO -m dd.$RAILWAY_SERVICE_NAME`. Railway injects this automatically from the
# service name, so prod/dev need nothing; a self-hosted deploy (the Pi B+) MUST set it,
# and supervisord refuses to start at all if it is unset rather than guessing.
# RAILWAY_SERVICE_NAME=beacon
#
# Arms the break-glass sshd (port 2222, non-root) that lets you get a shell into a
# container whose bot has died. Unset (the default) = sshd runs but authorizes nobody.
# One public key per line; a dotenv file can only express one.
# SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA... you@yourbox
#
# jemalloc tuning. The image bakes the shared settings, which are the beacon-correct
# ones. ANCHOR should override this variable with the value below to add narenas:2 —
# jemalloc's default of 4*ncpu reserves per-arena metadata that bloats anchor's small,
# single-event-loop process for no concurrency benefit, while beacon (the large, hot
# consumer that arena parallelism actually helps) wants the default. It cannot be baked
# per-bot: one image, one supervisord program, and supervisord has no conditionals.
# Forgetting it costs anchor a little RAM; nothing breaks.
# MALLOC_CONF=narenas:2,background_thread:true,dirty_decay_ms:10000,muzzy_decay_ms:10000

# Webserver port (Bungie OAuth callback + rotation editor); defaults to 8080
PORT=8080

# Public origin the anchor web app is reachable at, used to mint rotation-editor links.
# On Railway this is derived from RAILWAY_PUBLIC_DOMAIN automatically; set this only to
# override (e.g. a custom domain). Scheme required; no trailing slash.
# PUBLIC_BASE_URL=https://anchor.example.com

# Bungie Credentials

BUNGIE_API_KEY="uewhfhewfuojewiofjeiowfjew"
BUNGIE_CLIENT_ID=438481
BUNGIE_CLIENT_SECRET="fjruwifhuewjfeiwjfeuiw-fehwuofj"

# Discord OAuth for the anchor web UI (rotation editor + weekly-reset form).
# CLIENT_ID is the bot's application id; CLIENT_SECRET is from the Developer Portal's
# OAuth2 tab (NOT the bot token). Register the redirect {PUBLIC_BASE_URL}/auth/callback
# under Portal -> OAuth2 -> Redirects. Both may be left blank for local dev without a
# tunnel (the /auth/login route then surfaces a clear error).
DISCORD_OAUTH_CLIENT_ID=438481
DISCORD_OAUTH_CLIENT_SECRET="fjruwifhuewjfeiwjfeuiw-fehwuofj"
# Dev-only auth bypass for the web UI: a Discord user id treated as an authenticated
# owner so you can hit the editors without the OAuth round-trip. Honored ONLY when
# TEST_ENV is set AND there is no PUBLIC_BASE_URL (i.e. local dev without a tunnel) — so
# it stays inert on the internet-facing dev/prod deploys. Leave unset unless doing local dev.
# DEV_AUTH_USER_ID=1000000000000000000

# Spin-up-to-test dev bots (make run-*-devbot / devbot-up). They run against an isolated
# schema (default kyber_devbot) so they can't clobber the shared `kyber` DB, and launch
# with a raised OOM score so they're reaped before the Claude session under dd-dev's memory
# cap (its mem_limit in infra's dev/compose.yaml). The make targets load this file with
# `uv run --env-file .env`, so these are read from here.
# DEVBOT_SCHEMA=kyber_devbot
# DEVBOT_OOM_SCORE_ADJ=800
# The runner LD_PRELOADs jemalloc (like prod) when libjemalloc2 is in the dev image;
# set to 0 to force glibc malloc for an A/B RAM comparison.
# DEVBOT_JEMALLOC=1
